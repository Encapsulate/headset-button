#!/usr/bin/env python3
"""Thin launcher for the headset-button bridge daemon."""
import os
import sys

_HERE = os.path.dirname(os.path.realpath(__file__))
_SRC = os.path.join(os.path.dirname(_HERE), "src")
if os.path.isdir(os.path.join(_SRC, "headset_button")):
    sys.path.insert(0, _SRC)

from headset_button.bridge import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
